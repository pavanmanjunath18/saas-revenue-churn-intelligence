# SaaS Revenue & Churn Intelligence Platform — Environment Configuration
# Copy this file to .env and adjust as necessary for your local environment.

# PostgreSQL Configuration
POSTGRES_USER=saas_user
POSTGRES_PASSWORD=saas_pass
POSTGRES_DB=saas_platform
POSTGRES_HOST=localhost

# Use port 5433 to avoid conflicts with other local PostgreSQL databases (mapped in docker-compose.yml)
POSTGRES_PORT=5433

# Database Connection URL (used by scripts and the Streamlit app)
DATABASE_URL=postgresql://saas_user:saas_pass@localhost:5433/saas_platform
